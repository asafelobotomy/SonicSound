<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focus wins over selected so D-pad focus is always the strongest cue. -->
    <item android:drawable="@drawable/round_outline_selected" android:state_focused="true" />
    <item android:drawable="@drawable/round_outline_current" android:state_selected="true" />
    <item android:drawable="@drawable/round_outline" />
</selector>
