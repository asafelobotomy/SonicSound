<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sonicsound_background"
    android:fillViewport="true"
    tools:context=".SettingsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat"
            android:text="@string/settings_header"
            android:textColor="#fff"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Playback -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/montserrat"
            android:text="@string/settings_section_playback"
            android:textColor="#fff"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/montserrat"
            android:text="@string/transcoding_label"
            android:textColor="#ccffffff"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_transcoding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/round_outline_selector"
            android:focusable="true"
            android:fontFamily="@font/montserrat"
            android:hint="@string/transcoding_hint"
            android:inputType="text"
            android:padding="12dp"
            android:textColor="#fff"
            android:textColorHint="#66ffffff" />

        <!-- Audio -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/montserrat"
            android:text="@string/settings_section_audio"
            android:textColor="#fff"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/montserrat"
            android:text="@string/audio_profile_label"
            android:textColor="#ccffffff"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spinner_audio_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/round_outline_selector"
            android:focusable="true"
            android:padding="12dp" />

        <LinearLayout
            android:id="@+id/ll_vinyl_condition_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat"
                android:text="@string/vinyl_condition_label"
                android:textColor="#ccffffff"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spinner_vinyl_condition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/round_outline_selector"
                android:focusable="true"
                android:padding="12dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_replaygain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/round_outline_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_replaygain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat"
                android:paddingStart="12dp"
                android:text="@string/replaygain_enabled"
                android:textColor="#fff"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Fullscreen visualizer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/montserrat"
            android:text="@string/settings_section_fullscreen"
            android:textColor="#fff"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/montserrat"
            android:text="@string/fullscreen_visualizer_label"
            android:textColor="#ccffffff"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spinner_fullscreen_visualizer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/round_outline_selector"
            android:focusable="true"
            android:minHeight="48dp"
            android:padding="8dp" />

        <LinearLayout
            android:id="@+id/ll_solid_color_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat"
                android:text="@string/fullscreen_solid_color_label"
                android:textColor="#ccffffff"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ll_solid_color_swatches"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_dvd_speed_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat"
                android:text="@string/dvd_speed_label"
                android:textColor="#ccffffff"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spinner_dvd_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/round_outline_selector"
                android:focusable="true"
                android:minHeight="48dp"
                android:padding="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_fs_clock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/round_outline_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_fs_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat"
                android:paddingStart="12dp"
                android:text="@string/fullscreen_show_clock"
                android:textColor="#fff"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_fs_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/round_outline_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_fs_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat"
                android:paddingStart="12dp"
                android:text="@string/fullscreen_show_date"
                android:textColor="#fff"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Cache -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/montserrat"
            android:text="@string/settings_section_cache"
            android:textColor="#fff"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/montserrat"
            android:text="@string/cache_size_label"
            android:textColor="#ccffffff"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/et_cache_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/round_outline_selector"
            android:focusable="true"
            android:fontFamily="@font/montserrat"
            android:hint="@string/cache_size_hint"
            android:inputType="number"
            android:padding="12dp"
            android:textColor="#fff"
            android:textColorHint="#66ffffff" />

        <TextView
            android:id="@+id/tv_cache_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/montserrat"
            android:textColor="#99ffffff"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_clear_cache"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/round_outline_selector"
            android:focusable="true"
            android:text="@string/clear_cache"
            android:textAllCaps="false"
            android:textColor="#fff" />

        <LinearLayout
            android:id="@+id/row_offline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/round_outline_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_offline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat"
                android:paddingStart="12dp"
                android:text="@string/offline_mode"
                android:textColor="#fff"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- About / updates -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/montserrat"
            android:text="@string/settings_section_about"
            android:textColor="#fff"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_app_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/montserrat"
            android:textColor="#99ffffff"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_check_updates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/round_outline_selector"
            android:focusable="true"
            android:text="@string/check_for_updates"
            android:textAllCaps="false"
            android:textColor="#fff" />
    </LinearLayout>
</ScrollView>
