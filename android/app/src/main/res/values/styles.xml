<?xml version="1.0" encoding="utf-8"?>
<resources>
    <item name="sonicsound_background" type="color">#282c34</item>
    <item name="sonicsound_item_highlight" type="color">#626c80</item>
    <item name="scrubber_thumb_armed" type="color">#FFFFFF</item>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/sonicsound_background</item>
    </style>


    <!-- Solid launch background only — content splash draws the logo; avoid stacking
         the old Capacitor splash.png under/behind it. -->
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
        <item name="android:windowBackground">@color/sonicsound_background</item>
    </style>
</resources>