<?xml version="1.0" encoding="utf-8"?>
<!--
  SonicSound connects to self-hosted Subsonic/Navidrome servers.
  Cleartext HTTP is permitted for LAN servers that do not offer TLS.
  Prefer HTTPS when your server supports it (no app setting required —
  use an https:// account URL).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
