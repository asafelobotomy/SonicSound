<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#282c34"
    tools:context=".TvActivity">

    <LinearLayout
        android:id="@+id/menu_container"
        android:layout_width="@dimen/tv_sidebar_width"
        android:layout_height="match_parent"
        android:gravity="start"
        android:orientation="vertical"
        android:paddingLeft="8dp"
        android:paddingTop="8dp"
        android:paddingRight="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/iv_sidebar_logo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:src="@drawable/ic_logo"
            android:tint="#FFFFFF"
            tools:ignore="ContentDescription" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btn_home"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_sonicsound_height"
                    android:layout_marginVertical="@dimen/tv_nav_margin"
                    android:background="@drawable/round_outline_selector"
                    android:contentDescription="@string/home_button_content"
                    android:drawableStart="@drawable/ic_nav_home"
                    android:fontFamily="@font/montserrat"
                    android:gravity="center_vertical"
                    android:nextFocusRight="@id/fg_container"
                    android:padding="5dp"
                    android:text="@string/home_button_content"
                    android:textAllCaps="false"
                    android:textColor="#ffffff"
                    android:textSize="@dimen/button_sonicsound_text_size" />

                <Button
                    android:id="@+id/btn_artists"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_sonicsound_height"
                    android:layout_marginVertical="@dimen/tv_nav_margin"
                    android:background="@drawable/round_outline_selector"
                    android:contentDescription="@string/artists_button_content"
                    android:drawableStart="@drawable/ic_nav_artists"
                    android:fontFamily="@font/montserrat"
                    android:gravity="center_vertical"
                    android:nextFocusRight="@id/fg_container"
                    android:padding="5dp"
                    android:text="@string/artists_button_content"
                    android:textAllCaps="false"
                    android:textColor="#ffffff"
                    android:textSize="@dimen/button_sonicsound_text_size" />

                <Button
                    android:id="@+id/btn_albums"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_sonicsound_height"
                    android:layout_marginVertical="@dimen/tv_nav_margin"
                    android:background="@drawable/round_outline_selector"
                    android:contentDescription="@string/albums_button_content"
                    android:drawableStart="@drawable/ic_nav_albums"
                    android:fontFamily="@font/montserrat"
                    android:gravity="center_vertical"
                    android:nextFocusRight="@id/fg_container"
                    android:padding="5dp"
                    android:text="@string/albums_button_content"
                    android:textAllCaps="false"
                    android:textColor="#ffffff"
                    android:textSize="@dimen/button_sonicsound_text_size" />

                <Button
                    android:id="@+id/btn_search"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_sonicsound_height"
                    android:layout_marginVertical="@dimen/tv_nav_margin"
                    android:background="@drawable/round_outline_selector"
                    android:contentDescription="@string/search_button_content"
                    android:drawableStart="@drawable/ic_nav_search"
                    android:fontFamily="@font/montserrat"
                    android:gravity="center_vertical"
                    android:nextFocusRight="@id/fg_container"
                    android:padding="5dp"
                    android:text="@string/search_button_content"
                    android:textAllCaps="false"
                    android:textColor="#ffffff"
                    android:textSize="@dimen/button_sonicsound_text_size" />

                <Button
                    android:id="@+id/btn_playlists"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_sonicsound_height"
                    android:layout_marginVertical="@dimen/tv_nav_margin"
                    android:background="@drawable/round_outline_selector"
                    android:contentDescription="@string/playlists_button_content"
                    android:drawableStart="@drawable/ic_nav_playlists"
                    android:fontFamily="@font/montserrat"
                    android:gravity="center_vertical"
                    android:nextFocusRight="@id/fg_container"
                    android:padding="5dp"
                    android:text="@string/playlists_button_content"
                    android:textAllCaps="false"
                    android:textColor="#ffffff"
                    android:textSize="@dimen/button_sonicsound_text_size" />

                <Button
                    android:id="@+id/btn_radio"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_sonicsound_height"
                    android:layout_marginVertical="@dimen/tv_nav_margin"
                    android:background="@drawable/round_outline_selector"
                    android:contentDescription="@string/radio_button_content"
                    android:drawableStart="@drawable/ic_nav_radio"
                    android:fontFamily="@font/montserrat"
                    android:gravity="center_vertical"
                    android:nextFocusRight="@id/fg_container"
                    android:padding="5dp"
                    android:text="@string/radio_button_content"
                    android:textAllCaps="false"
                    android:textColor="#ffffff"
                    android:textSize="@dimen/button_sonicsound_text_size" />

                <Button
                    android:id="@+id/btn_videos"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_sonicsound_height"
                    android:layout_marginVertical="@dimen/tv_nav_margin"
                    android:background="@drawable/round_outline_selector"
                    android:contentDescription="@string/videos_button_content"
                    android:drawableStart="@drawable/ic_nav_videos"
                    android:fontFamily="@font/montserrat"
                    android:gravity="center_vertical"
                    android:nextFocusRight="@id/fg_container"
                    android:padding="5dp"
                    android:text="@string/videos_button_content"
                    android:textAllCaps="false"
                    android:textColor="#ffffff"
                    android:textSize="@dimen/button_sonicsound_text_size" />

                <Button
                    android:id="@+id/btn_account"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_sonicsound_height"
                    android:layout_marginVertical="@dimen/tv_nav_margin"
                    android:background="@drawable/round_outline_selector"
                    android:contentDescription="@string/account_button_content"
                    android:drawableStart="@drawable/ic_nav_account"
                    android:fontFamily="@font/montserrat"
                    android:gravity="center_vertical"
                    android:nextFocusRight="@id/fg_container"
                    android:padding="5dp"
                    android:text="@string/account_button_content"
                    android:textAllCaps="false"
                    android:textColor="#ffffff"
                    android:textSize="@dimen/button_sonicsound_text_size" />

                <Button
                    android:id="@+id/btn_settings"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_sonicsound_height"
                    android:layout_marginVertical="@dimen/tv_nav_margin"
                    android:background="@drawable/round_outline_selector"
                    android:contentDescription="@string/settings_button_content"
                    android:drawableStart="@drawable/ic_nav_settings"
                    android:fontFamily="@font/montserrat"
                    android:gravity="center_vertical"
                    android:nextFocusRight="@id/fg_container"
                    android:padding="5dp"
                    android:text="@string/settings_button_content"
                    android:textAllCaps="false"
                    android:textColor="#ffffff"
                    android:textSize="@dimen/button_sonicsound_text_size" />

                <Button
                    android:id="@+id/btn_jukebox"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_sonicsound_height"
                    android:layout_marginVertical="@dimen/tv_nav_margin"
                    android:background="@drawable/round_outline_selector"
                    android:contentDescription="@string/jukebox_button_content"
                    android:drawableStart="@drawable/ic_nav_jukebox"
                    android:fontFamily="@font/montserrat"
                    android:gravity="center_vertical"
                    android:nextFocusRight="@id/fg_container"
                    android:padding="5dp"
                    android:text="@string/jukebox_button_content"
                    android:textAllCaps="false"
                    android:textColor="#ffffff"
                    android:textSize="@dimen/button_sonicsound_text_size" />
            </LinearLayout>
        </ScrollView>

        <ImageView
            android:id="@+id/iv_phone_connected"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="4dp"
            android:src="@drawable/ic_smartphone_line"
            android:visibility="invisible"
            tools:ignore="ContentDescription" />

        <Button
            android:id="@+id/btn_playing"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_sonicsound_height"
            android:layout_marginVertical="@dimen/tv_nav_margin"
            android:background="@drawable/round_outline_selector"
            android:contentDescription="@string/playing_button_content"
            android:drawableStart="@drawable/ic_nav_playing"
            android:fontFamily="@font/montserrat"
            android:gravity="center_vertical"
            android:nextFocusRight="@id/fg_container"
            android:padding="5dp"
            android:text="@string/playing_button_content"
            android:textAllCaps="false"
            android:textColor="#ffffff"
            android:textSize="@dimen/button_sonicsound_text_size" />
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fg_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toEndOf="@+id/menu_container"
        android:paddingTop="@dimen/tv_content_padding"
        android:paddingEnd="@dimen/tv_content_padding"
        android:paddingBottom="@dimen/tv_section_gap"
        android:clipToPadding="false" />

</RelativeLayout>
