<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.NowPlayingFragment">

    <ImageView
        android:id="@+id/img_now_playing_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/album_art_image_on_playing"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC282c34" />

    <LinearLayout
        android:id="@+id/ll_now_playing_chrome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/ll_container_album_art"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingEnd="8dp"
                tools:ignore="NestedWeights">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <FrameLayout
                        android:id="@+id/fl_now_playing_media"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@android:color/transparent"
                        android:clickable="true"
                        android:contentDescription="@string/fullscreen_media"
                        android:focusable="true"
                        android:foreground="@drawable/focus_frame_selector"
                        android:padding="4dp"
                        android:tag="primary_focus"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="H,1:1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_max="860dp">

                        <ImageView
                            android:id="@+id/img_now_playing_album_art"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/album_art_image_on_playing"
                            android:focusable="false"
                            android:scaleType="fitCenter" />

                        <FrameLayout
                            android:id="@+id/fl_music_video"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />
                    </FrameLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/ll_container_list"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.95"
                android:minWidth="280dp"
                android:orientation="vertical"
                android:paddingStart="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat"
                    android:paddingBottom="4dp"
                    android:text="@string/queue_header"
                    android:textColor="#99ffffff"
                    android:textSize="13sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_now_playing_playlist"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingVertical="2dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/controls_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="4dp">

            <ImageButton
                android:id="@+id/btn_shuffle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/round_outline_selector"
                android:contentDescription="@string/button_content_description"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_shuffle_fill" />

            <ImageButton
                android:id="@+id/btn_repeat"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/round_outline_selector"
                android:contentDescription="@string/repeat_off"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_repeat" />

            <ImageButton
                android:id="@+id/btn_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/round_outline_selector"
                android:contentDescription="@string/button_content_description"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_skip_back" />

            <ImageButton
                android:id="@+id/btn_play_pause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/round_outline_selector"
                android:contentDescription="@string/button_content_description"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_play" />

            <ImageButton
                android:id="@+id/btn_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/round_outline_selector"
                android:contentDescription="@string/button_content_description"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_skip_forward" />

            <ImageButton
                android:id="@+id/btn_music_video"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/round_outline_selector"
                android:contentDescription="@string/play_music_video"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_nav_videos" />

            <ImageButton
                android:id="@+id/btn_like"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/round_outline_selector"
                android:contentDescription="@string/like_song"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_nav_unlike" />

            <ImageButton
                android:id="@+id/btn_add_to_playlist"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="5dp"
                android:background="@drawable/round_outline_selector"
                android:contentDescription="@string/add_to_playlist"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_nav_playlists" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_scrubber_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="48dp">

                <TextView
                    android:id="@+id/tv_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat"
                    android:textColor="#fff"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_track_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="@font/montserrat"
                    android:textColor="#fff"
                    android:textSize="12sp"
                    tools:ignore="RelativeOverlap" />
            </RelativeLayout>

            <SeekBar
                android:id="@+id/sb_now_playing_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="40dp"
                android:focusable="true"
                android:max="1000"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:progressTint="@color/sonicsound_item_highlight"
                android:thumbTint="@color/sonicsound_item_highlight" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_track_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/tv_now_playing_first_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/montserrat"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#fff"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_now_playing_second_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/montserrat"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#ccffffff"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Fullscreen: vertical stack so art never overlaps chrome -->
    <FrameLayout
        android:id="@+id/fl_fullscreen_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6282c34"
        android:clickable="true"
        android:descendantFocusability="afterDescendants"
        android:focusable="false"
        android:visibility="gone">

        <View
            android:id="@+id/v_fs_solid_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/img_fs_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.35"
            android:contentDescription="@string/album_art_image_on_playing"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:id="@+id/ll_fs_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="32dp"
            android:layout_marginTop="28dp"
            android:elevation="4dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_fs_clock_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat"
                android:textColor="#fff"
                android:textSize="22sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_fs_clock_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/montserrat"
                android:textColor="#ccffffff"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_fs_stack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="28dp"
            android:paddingEnd="32dp"
            android:paddingBottom="12dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <FrameLayout
                android:id="@+id/fl_fs_media"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/img_fs_art"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:adjustViewBounds="false"
                    android:contentDescription="@string/album_art_image_on_playing"
                    android:cropToPadding="false"
                    android:scaleType="fitCenter" />

                <View
                    android:id="@+id/v_fs_focus_anchor"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:layout_gravity="center"
                    android:background="@android:color/transparent"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />
            </FrameLayout>

            <RelativeLayout
                android:id="@+id/ll_fs_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="56dp"
                android:paddingHorizontal="8dp">

                <LinearLayout
                    android:id="@+id/ll_fs_track_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="176dp">

                    <TextView
                        android:id="@+id/tv_fs_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/montserrat"
                        android:gravity="center"
                        android:maxLines="2"
                        android:textColor="#fff"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_fs_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/montserrat"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="#ccffffff"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_fs_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/round_outline"
                    android:focusable="false"
                    android:gravity="center_vertical"
                    android:maxWidth="180dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="6dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="top"
                        android:layout_marginTop="2dp"
                        android:contentDescription="@string/next_up"
                        android:focusable="false"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_skip_forward"
                        android:tint="#ccffffff" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_fs_next_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/montserrat"
                            android:maxWidth="140dp"
                            android:maxLines="2"
                            android:textColor="#fff"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_fs_next_artist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/montserrat"
                            android:maxWidth="140dp"
                            android:maxLines="1"
                            android:textColor="#ccffffff"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/ll_fs_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/ll_fs_buttons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btn_fs_shuffle"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="@drawable/round_outline_selector"
                        android:contentDescription="@string/button_content_description"
                        android:focusable="true"
                        android:src="@drawable/ic_shuffle_fill" />

                    <ImageButton
                        android:id="@+id/btn_fs_repeat"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="@drawable/round_outline_selector"
                        android:contentDescription="@string/repeat_off"
                        android:focusable="true"
                        android:src="@drawable/ic_repeat" />

                    <ImageButton
                        android:id="@+id/btn_fs_prev"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="@drawable/round_outline_selector"
                        android:contentDescription="@string/button_content_description"
                        android:focusable="true"
                        android:src="@drawable/ic_skip_back" />

                    <ImageButton
                        android:id="@+id/btn_fs_play"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="@drawable/round_outline_selector"
                        android:contentDescription="@string/button_content_description"
                        android:focusable="true"
                        android:src="@drawable/ic_play" />

                    <ImageButton
                        android:id="@+id/btn_fs_next"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="@drawable/round_outline_selector"
                        android:contentDescription="@string/button_content_description"
                        android:focusable="true"
                        android:src="@drawable/ic_skip_forward" />

                    <ImageButton
                        android:id="@+id/btn_fs_music_video"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="@drawable/round_outline_selector"
                        android:contentDescription="@string/play_music_video"
                        android:focusable="true"
                        android:src="@drawable/ic_nav_videos" />

                    <ImageButton
                        android:id="@+id/btn_fs_like"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginHorizontal="6dp"
                        android:background="@drawable/round_outline_selector"
                        android:contentDescription="@string/like_song"
                        android:focusable="true"
                        android:src="@drawable/ic_nav_unlike" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_fs_scrubber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="24dp">

                        <TextView
                            android:id="@+id/tv_fs_current_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat"
                            android:textColor="#fff"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_fs_duration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="@font/montserrat"
                            android:textColor="#fff"
                            android:textSize="12sp"
                            tools:ignore="RelativeOverlap" />
                    </RelativeLayout>

                    <SeekBar
                        android:id="@+id/sb_fs_progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:focusable="true"
                        android:max="1000"
                        android:progressTint="@color/sonicsound_item_highlight"
                        android:thumbTint="@color/sonicsound_item_highlight" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
